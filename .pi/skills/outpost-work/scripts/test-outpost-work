#!/usr/bin/env bash
set -euo pipefail

skill_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
mkdir -p "$tmp/bin" "$tmp/home/.pi/agent" "$tmp/home/.config/git" "$tmp/scripts"
log=$tmp/outpost.log
state=$tmp/state
secret='super-secret-token'
printf '%s' 'pi-auth' > "$tmp/home/.pi/agent/auth.json"
printf '%s' '[user]\nname = Test' > "$tmp/home/.config/git/config"

cat > "$tmp/bin/outpost" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
for argument in "$@"; do
  if [[ $argument =~ [[:cntrl:]] ]]; then
    echo 'control character in Outpost argument' >&2
    exit 64
  fi
done
stdin_file=$(mktemp)
trap 'rm -f "$stdin_file"' EXIT
cat > "$stdin_file"
stdin_hash=$(sha256sum "$stdin_file" | awk '{print $1}')
printf 'argv:' >> "$FAKE_OUTPOST_LOG"
printf ' %q' "$@" >> "$FAKE_OUTPOST_LOG"
printf ' stdin-sha256:%s' "$stdin_hash" >> "$FAKE_OUTPOST_LOG"
if [[ $1 == copy ]]; then
  printf ' source-sha256:%s' "$(sha256sum "$2" | awk '{print $1}')" >> "$FAKE_OUTPOST_LOG"
fi
if [[ $1 == exec ]] && [[ $# -ge 5 ]] && [[ $4 == bash && $5 == -seu ]]; then
  cp "$stdin_file" "$FAKE_OUTPOST_SCRIPTS/$stdin_hash"
  printf ' streamed-script:%s' "$stdin_hash" >> "$FAKE_OUTPOST_LOG"
fi
printf '\n' >> "$FAKE_OUTPOST_LOG"
if [[ $# -ge 3 ]] && [[ $1 == --output && $2 == json && $3 == inspect ]]; then
  printf '{"status":"%s"}\n' "$FAKE_OUTPOST_STATUS"
fi
if [[ $1 == exec && " $* " == *' gh auth status '* && ! -e $FAKE_OUTPOST_STATE ]]; then
  : > "$FAKE_OUTPOST_STATE"
  exit 1
fi
EOF
cat > "$tmp/bin/gh" <<EOF
#!/usr/bin/env bash
if [[ \$1 == auth && \$2 == token ]]; then
  printf '%s\\n' '$secret'
fi
EOF
chmod 700 "$tmp/bin/outpost" "$tmp/bin/gh"

export PATH="$tmp/bin:$PATH"
export HOME=$tmp/home
unset OUTPOST_SERVER OUTPOST_TOKEN OUTPOST_SSH_PROXY_JUMP
export FAKE_OUTPOST_LOG=$log
export FAKE_OUTPOST_STATE=$state
export FAKE_OUTPOST_SCRIPTS=$tmp/scripts

export FAKE_OUTPOST_STATUS=stopped
bootstrap_output=$("$skill_dir/bootstrap" demo 2>&1)
export FAKE_OUTPOST_STATUS=running
running_output=$("$skill_dir/bootstrap" demo 2>&1)
export FAKE_OUTPOST_STATUS=provisioning
if "$skill_dir/bootstrap" demo >/dev/null 2>&1; then
  echo 'unsupported lifecycle status was accepted' >&2
  exit 1
fi
export FAKE_OUTPOST_STATUS=running
launch_output=$(printf 'do the work' | "$skill_dir/launch-pi" demo work-8 /root/repo gpt-5.6-terra medium 2>&1)

expected_token_hash=$(printf '%s\n' "$secret" | sha256sum | awk '{print $1}')
expected_prompt_hash=$(printf '%s' 'do the work' | sha256sum | awk '{print $1}')
grep -Eq '^argv: --output json inspect demo stdin-sha256:' "$log"
[[ $(grep -Fc 'argv: start demo stdin-sha256:' "$log") -eq 1 ]]
grep -Eq '^argv: exec demo -- bash -seu stdin-sha256:.*streamed-script:' "$log"
grep -Eq '^argv: exec demo -- bash -seu -- work-8 /root/repo gpt-5\.6-terra medium /root/\.outpost-work/prompts/work-8 stdin-sha256:.*streamed-script:' "$log"
grep -Eq '^argv: copy .+ demo:/root/\.pi/agent/auth\.json stdin-sha256:' "$log"
grep -Eq '^argv: copy .+ demo:/root/\.outpost-work/prompts/work-8 stdin-sha256:.*source-sha256:'"$expected_prompt_hash"'$' "$log"
grep -Fq 'argv: exec demo -- chmod 600 /root/.pi/agent/auth.json' "$log"
grep -Fq 'argv: exec demo -- chmod 600 /root/.outpost-work/prompts/work-8' "$log"
grep -Fq "stdin-sha256:$expected_token_hash" "$log"
grep -RlF 'apt-get install -y --no-install-recommends' "$tmp/scripts" >/dev/null
grep -RlF 'mise use --global node@latest' "$tmp/scripts" >/dev/null
grep -RlF 'tmux new-session -d -s' "$tmp/scripts" >/dev/null
pi_launch="pi --model \"\$1\" --thinking \"\$2\""
grep -RlF "$pi_launch" "$tmp/scripts" >/dev/null
grep -RlF 'url.https://github.com/.insteadOf http://github.com/' "$tmp/scripts" >/dev/null
if grep -Fq -- "$secret" "$log" || [[ $bootstrap_output$running_output$launch_output == *"$secret"* ]]; then
  echo 'secret was emitted' >&2
  exit 1
fi

if "$skill_dir/bootstrap" 'bad name' >/dev/null 2>&1; then
  echo 'invalid Outpost name was accepted' >&2
  exit 1
fi
if printf 'prompt' | "$skill_dir/launch-pi" demo 'bad name' /root gpt-5.6-terra medium >/dev/null 2>&1; then
  echo 'invalid tmux name was accepted' >&2
  exit 1
fi
if printf 'prompt' | "$skill_dir/launch-pi" demo valid relative gpt-5.6-terra medium >/dev/null 2>&1; then
  echo 'relative directory was accepted' >&2
  exit 1
fi
if printf 'prompt' | "$skill_dir/launch-pi" demo valid $'/root/a\tb' gpt-5.6-terra medium >/dev/null 2>&1; then
  echo 'control character in directory was accepted' >&2
  exit 1
fi
if printf 'prompt' | "$skill_dir/launch-pi" demo valid /root 'bad model!' medium >/dev/null 2>&1; then
  echo 'invalid model was accepted' >&2
  exit 1
fi
if printf 'prompt' | "$skill_dir/launch-pi" demo valid /root gpt-5.6-terra invalid >/dev/null 2>&1; then
  echo 'invalid reasoning was accepted' >&2
  exit 1
fi

echo 'outpost-work script tests passed'
