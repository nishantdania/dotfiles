#!/usr/bin/env bash
set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"

if [[ $# -ne 5 ]]; then
  echo "usage: launch-pi <outpost> <tmux-name> <working-directory> <model> <reasoning>" >&2
  exit 2
fi

vm=$1
session=$2
directory=$3
model=$4
reasoning=$5

if [[ ! $session =~ ^[a-zA-Z0-9_-]+$ ]]; then
  echo "tmux name may contain only letters, numbers, underscores, and hyphens" >&2
  exit 2
fi
if [[ $directory != /* ]]; then
  echo "working directory must be absolute" >&2
  exit 2
fi
if [[ ! $model =~ ^[a-zA-Z0-9._:/-]+$ ]]; then
  echo "invalid model" >&2
  exit 2
fi
case $reasoning in
  off|minimal|low|medium|high|xhigh|max) ;;
  *) echo "invalid reasoning level" >&2; exit 2 ;;
esac

prompt=$(mktemp)
trap 'rm -f "$prompt"' EXIT
cat > "$prompt"
if [[ ! -s $prompt ]]; then
  echo "remote Pi prompt is empty" >&2
  exit 2
fi

prompt_path="/root/.outpost/prompts/$session"
outpost copy --mode 600 "$prompt" "$vm:$prompt_path" >/dev/null

directory64=$(printf '%s' "$directory" | base64 -w0)
outpost exec "$vm" "set -eu; directory=\$(printf %s $directory64 | base64 -d); test -d \"\$directory\"; ! tmux has-session -t $session 2>/dev/null; tmux new-session -d -s $session -c \"\$directory\" 'exec /root/.local/bin/mise exec node@latest -- pi --model $model --thinking $reasoning \"\$(cat $prompt_path)\"'; tmux has-session -t $session"

printf 'Started %s in %s.\n' "$session" "$vm"
