#!/usr/bin/env bash
set -euo pipefail

case $- in
  *x*) echo "launch-pi must not run with shell tracing enabled" >&2; exit 2 ;;
esac

if [[ $# -ne 5 ]]; then
  echo "usage: launch-pi <outpost> <tmux-name> <working-directory> <model> <reasoning>" >&2
  exit 2
fi

outpost_name=$1
session=$2
directory=$3
model=$4
reasoning=$5

if ! command -v outpost >/dev/null 2>&1; then
  echo "outpost CLI is not installed" >&2
  exit 1
fi
if [[ ! $outpost_name =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]]; then
  echo "invalid Outpost name" >&2
  exit 2
fi
if [[ ! $session =~ ^[a-zA-Z0-9_-]+$ ]]; then
  echo "tmux name may contain only letters, numbers, underscores, and hyphens" >&2
  exit 2
fi
if [[ $directory != /* || $directory =~ [[:cntrl:]] ]]; then
  echo "working directory must be an absolute path without control characters" >&2
  exit 2
fi
if [[ ! $model =~ ^[a-zA-Z0-9._:/-]+$ ]]; then
  echo "invalid model" >&2
  exit 2
fi
case $reasoning in
  off|minimal|low|medium|high|xhigh|max) ;;
  *) echo "invalid reasoning level" >&2; exit 2 ;;
esac

umask 077
prompt=$(mktemp)
trap 'rm -f "$prompt"' EXIT
cat > "$prompt"
if [[ ! -s $prompt ]]; then
  echo "remote Pi prompt is empty" >&2
  exit 2
fi

prompt_dir=/root/.outpost-work/prompts
prompt_path=$prompt_dir/$session
outpost exec "$outpost_name" -- mkdir -p "$prompt_dir"
outpost exec "$outpost_name" -- chmod 700 /root/.outpost-work "$prompt_dir"
outpost copy "$prompt" "$outpost_name:$prompt_path" >/dev/null
outpost exec "$outpost_name" -- chmod 600 "$prompt_path"
outpost exec "$outpost_name" -- test -d "$directory"

outpost exec "$outpost_name" -- bash -seu -- "$session" "$directory" "$model" "$reasoning" "$prompt_path" <<'EOF'
if tmux has-session -t "$1" 2>/dev/null; then
  echo "tmux session already exists: $1" >&2
  exit 1
fi
tmux new-session -d -s "$1" -c "$2" bash -ceu 'exec /root/.local/bin/mise exec node@latest -- pi --model "$1" --thinking "$2" "$(cat "$3")"' bash "$3" "$4" "$5"
tmux has-session -t "$1"
EOF

printf 'Started %s in %s.\n' "$session" "$outpost_name"
