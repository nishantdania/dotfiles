#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
Usage:
  subagent-tmux spawn <session> <window> <prompt...>
  subagent-tmux list <session>
  subagent-tmux capture <session> <window>
  subagent-tmux send <session> <window> <message...>
  subagent-tmux attach <session>
EOF
  exit 2
}

command -v tmux >/dev/null || { echo 'tmux is required' >&2; exit 1; }
command -v pi >/dev/null || { echo 'pi is required' >&2; exit 1; }
(($# >= 1)) || usage

case "$1" in
  spawn)
    (($# >= 4)) || usage
    session=$2 window=$3
    shift 3
    prompt=$*
    if tmux has-session -t "$session" 2>/dev/null; then
      if tmux list-windows -t "$session" -F '#W' | grep -Fxq "$window"; then
        echo "window already exists: $session:$window" >&2
        exit 1
      fi
      tmux new-window -d -t "$session" -n "$window" -c "$PWD" -- pi --name "$window" "$prompt"
    else
      tmux new-session -d -s "$session" -n "$window" -c "$PWD" -- pi --name "$window" "$prompt"
    fi
    printf '%s:%s\n' "$session" "$window"
    ;;
  list)
    (($# == 2)) || usage
    tmux list-windows -t "$2"
    ;;
  capture)
    (($# == 3)) || usage
    tmux capture-pane -p -t "$2:$3"
    ;;
  send)
    (($# >= 4)) || usage
    session=$2 window=$3
    shift 3
    tmux send-keys -t "$session:$window" "$*" Enter
    ;;
  attach)
    (($# == 2)) || usage
    exec tmux attach -t "$2"
    ;;
  *) usage ;;
esac
